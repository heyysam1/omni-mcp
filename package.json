{
  "name": "omni-mcp",
  "version": "1.0.0",
  "description": "Omni MCP",
  "repository": {
    "type": "git",
    "url": "https://github.com/heyysam1/omni-mcp.git"
  },
  "homepage": "https://github.com/heyysam1/omni-mcp#readme",
  "bugs": {
    "url": "https://github.com/heyysam1/omni-mcp/issues"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); ['dist', 'dist-electron'].forEach(d => { if (fs.existsSync(d)) fs.rmSync(d, { recursive: true, force: true }); });\"",
    "clean:release": "node -e \"const fs = require('fs'); if (fs.existsSync('release')) fs.rmSync('release', { recursive: true, force: true });\"",
    "dev": "vite",
    "compile:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --outfile=dist-electron/main.js && esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/preload.js",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:renderer && npm run compile:electron",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run clean:release && npm run build && electron-builder --win nsis",
    "build:installer": "npm run clean:release && npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.omnimcp.app",
    "productName": "Omni MCP",
    "publish": [
      {
        "provider": "github",
        "owner": "heyysam1",
        "repo": "omni-mcp"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "electron/set-efficiency.exe"
    ],
    "asarUnpack": [
      "electron/set-efficiency.exe",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Omni MCP",
      "uninstallDisplayName": "Omni MCP"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}